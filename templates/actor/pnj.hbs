<div class="hdc-ficha pnj">
  <header class="hdc-topo compacto">
    <div class="identificacao">
      <div class="campos">
        <h1 class="titulo"><input type="text" name="name" value="{{actor.name}}" placeholder="Nome do PNJ"></h1>
        <label class="f"><span>Papel na história</span><input type="text" name="system.papel" value="{{system.papel}}" placeholder="delegado, capanga, cúmplice da criatura..."></label>
      </div>
      <div class="polaroid pequena" data-action="editarImagem" data-edit="img"><img src="{{actor.img}}" alt="{{actor.name}}"></div>
    </div>
  </header>

  <section class="hdc-corpo">
    <h2 class="sec">Resistência</h2>
    <div class="saude">
      <div class="trilha">
        <span class="lbl">Física</span>
        <select name="system.resistencia.fisica.max" class="curto">{{#each opcoesRes}}<option value="{{value}}" {{#if (eq value ../system.resistencia.fisica.max)}}selected{{/if}}>{{label}}</option>{{/each}}</select>
        {{#each trilhaFisica}}<a class="caixa {{#if on}}on{{/if}} {{#if alem}}alem{{/if}}" data-action="danoPnj" data-tipo="{{tipo}}" data-n="{{n}}"><i></i>{{n}}</a>{{/each}}
        {{#if system.foraDeCena.fisica}}<span class="alerta">Fora da cena</span>{{/if}}
      </div>
      <div class="trilha">
        <span class="lbl">Mental</span>
        <select name="system.resistencia.mental.max" class="curto">{{#each opcoesRes}}<option value="{{value}}" {{#if (eq value ../system.resistencia.mental.max)}}selected{{/if}}>{{label}}</option>{{/each}}</select>
        {{#each trilhaMental}}<a class="caixa {{#if on}}on{{/if}} {{#if alem}}alem{{/if}}" data-action="danoPnj" data-tipo="{{tipo}}" data-n="{{n}}"><i></i>{{n}}</a>{{/each}}
        {{#if system.foraDeCena.mental}}<span class="alerta">Fora da cena</span>{{/if}}
      </div>
      <p class="dica">Cada ponto de dano dá −1 dado nos testes daquele tipo. Quando o dano passa da Resistência, o PNJ sai da cena.</p>
    </div>

    <h2 class="sec">Dados</h2>
    <label class="f"><span>Perícias (ex.: Combate 6, Vigor 4, Vontade 3)</span><input type="text" name="system.pericias" value="{{system.pericias}}"></label>
    <div class="acoes-rapidas">
      {{#each system.listaPericias}}<a class="botao" data-action="rolarPnj" data-nome="{{nome}}" data-dados="{{dados}}"><i class="fas fa-dice-six"></i> {{nome}} {{dados}}</a>{{/each}}
    </div>

    <h2 class="sec">Armas <a class="add" data-action="criarItem" data-type="arma"><i class="fas fa-plus"></i></a></h2>
    <ul class="lista armas-resumo">
      {{#each armas}}
      <li data-item-id="{{item.id}}"><a class="rolavel" data-action="ataque"><i class="fas fa-crosshairs"></i> {{item.name}}</a>
        <span class="det">dano {{s.dano}} · alc. {{s.alcance}} · {{#if s.bonus}}+{{s.bonus}}{{else}}—{{/if}} · {{periciaLabel}}</span>
        <span class="ctrl"><a data-action="editarItem"><i class="fas fa-pen"></i></a> <a data-action="apagarItem"><i class="fas fa-trash"></i></a></span></li>
      {{/each}}
    </ul>

    <h2 class="sec">Descrição</h2>
    <textarea name="system.descricao" rows="4">{{system.descricao}}</textarea>
    <h2 class="sec">Notas do Narrador</h2>
    <textarea name="system.notas" rows="4">{{system.notas}}</textarea>
  </section>
</div>
